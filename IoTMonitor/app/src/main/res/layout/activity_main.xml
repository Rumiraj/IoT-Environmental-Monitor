<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1422"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IoT Monitor"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Environmental Monitoring Dashboard"
            android:textColor="#A8B7CC"
            android:textSize="14sp" />

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE STATUS"
                android:textColor="#A8B7CC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SIMULATION MODE"
                android:textColor="#FBBF24"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="ESP32 - Not connected"
                android:textColor="#A8B7CC"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Temperature -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TEMPERATURE"
                android:textColor="#A8B7CC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTemperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="-- °C"
                android:textColor="#60A5FA"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Humidity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RELATIVE HUMIDITY"
                android:textColor="#A8B7CC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHumidity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="-- %"
                android:textColor="#2DD4BF"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Air Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AIR QUALITY (DEMO SCORE)"
                android:textColor="#A8B7CC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAirQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="-- / 100"
                android:textColor="#A78BFA"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Simulated score, not measured AQI"
                android:textColor="#A8B7CC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Last Update -->
        <TextView
            android:id="@+id/textLastUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Waiting for sensor data..."
            android:textColor="#A8B7CC"
            android:textSize="13sp" />

        <!-- Refresh Button -->
        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="Refresh Readings"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>